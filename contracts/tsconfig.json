{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "node16",
      "moduleResolution": "node16"
    }
  },
  "include": ["./scripts", "./test", "./hardhat.config.ts"]
}
